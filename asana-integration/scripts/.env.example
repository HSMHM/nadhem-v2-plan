# ===== Asana credentials =====
# Personal Access Token من https://app.asana.com/0/my-apps
ASANA_PAT=

# معرّف المشروع (من رابط المشروع: https://app.asana.com/0/<PROJECT_GID>/list)
ASANA_PROJECT_GID=

# معرّفات الأقسام داخل المشروع
# جلبها عبر https://app.asana.com/api/1.0/projects/<PROJECT_GID>/sections
SECTION_ADD_GID=
SECTION_MOD_GID=

# ===== Defaults للـ FAD =====
DEFAULT_PM_NAME=أحمد محمد
DEFAULT_ANALYST_NAME=سارة علي

# ===== سلوك السكربت =====
# تأخير بين الطلبات (millisec) — حد أسانا 150 req/min = ~400ms بين الطلبات
ASANA_RATE_LIMIT_MS=400

# في dry-run يطبع شجرة المهام بدون إرسال
DRY_RUN=false
